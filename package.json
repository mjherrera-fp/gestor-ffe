{
  "name": "gestor-ffe",
  "private": true,
  "version": "0.1.9-alpha",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "rebuild:node": "npx rimraf node_modules/better-sqlite3-multiple-ciphers/build && node node_modules/node-gyp/bin/node-gyp.js rebuild --release --directory node_modules/better-sqlite3-multiple-ciphers",
    "rebuild:electron": "npx @electron/rebuild -f -w better-sqlite3-multiple-ciphers",
    "dev": "npm run rebuild:node && concurrently --raw --kill-others \"npm run dev:server\" \"npm run dev:electron:wait\"",
    "dev:server": "tsx watch --ignore \"**/*.sqlite\" --ignore \"**/*.sqlite-*\" --ignore \"**/*.db\" --ignore \"**/*.db-*\" --ignore \"uploads/**\" server.ts",
    "dev:electron": "electron .",
    "dev:electron:wait": "wait-on tcp:127.0.0.1:3100 && npm run dev:electron",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.js",
    "preview": "vite preview",
    "clean": "npx rimraf dist dist-server release",
    "postinstall": "patch-package",
    "lint": "tsc --noEmit",
    "pack:win": "npm run clean && npm run build && npm run build:server && npm run rebuild:electron && electron-builder --win --x64",
    "pack:win:portable": "npm run clean && npm run build && npm run build:server && npx rimraf node_modules/better-sqlite3-multiple-ciphers/build && npm run rebuild:electron && electron-builder --win --x64 -c.win.target=portable"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@headlessui/react": "^2.2.10",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "@react-email/components": "^1.0.12",
    "@tailwindcss/vite": "^4.1.14",
    "@tippyjs/react": "^4.2.6",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-horizontal-rule": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-subscript": "^3.31.3",
    "@tiptap/extension-superscript": "^3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-typography": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vitejs/plugin-react": "^5.0.4",
    "@xmldom/xmldom": "^0.9.12",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "docxtemplater": "^3.68.6",
    "express": "^4.22.3",
    "handlebars": "^4.7.9",
    "jszip": "^3.10.1",
    "lodash.throttle": "^4.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pizzip": "^3.2.0",
    "puppeteer": "^25.11.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hotkeys-hook": "^5.3.2",
    "react-is": "^19.2.6",
    "recharts": "^3.8.1",
    "sass": "^1.104.1",
    "tippy.js": "^6.3.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@base-ui/react": "^1.5.0",
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/lodash.throttle": "^4.1.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pizzip": "^3.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/xmldom": "^0.1.34",
    "class-variance-authority": "^0.7.1",
    "concurrently": "^9.2.1",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "patch-package": "^8.0.1",
    "react-email": "^6.9.5",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.maversoftlab.sge-ffe",
    "productName": "Gestor FFE",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "src/lib/updater.js",
      "src/lib/update-secret.js",
      "templates/**/*",
      "main.js",
      "preload.cjs",
      "splash.html",
      "package.json"
    ],
    "win": {
      "icon": "assets/favicon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "assets/icons",
      "target": "AppImage"
    },
    "mac": {
      "target": "zip"
    },
    "extraResources": [
      {
        "from": "binarios/${os}",
        "to": "binarios/${os}",
        "filter": [
          "**/*"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "info_instalador.txt",
      "createDesktopShortcut": true
    },
    "portable": {
      "splashImage": "assets/splash-unzip.bmp",
      "artifactName": "GestorFFE.exe"
    }
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12",
    "axios": "^1.20.0",
    "baseline-browser-mapping": "^2.11.24",
    "body-parser": "^1.20.6",
    "browserslist": "^4.29.0",
    "engine.io": "^6.6.10",
    "fast-uri": "^3.1.8",
    "form-data": "^4.0.6",
    "ip-address": "^10.7.2",
    "joi": "^18.2.5",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.19",
    "postcss": "^8.5.28",
    "qs": "^6.16.0",
    "react-email": {
      "esbuild": "^0.28.2"
    },
    "shell-quote": "^1.10.0",
    "socket.io-adapter": "^2.5.8",
    "socket.io-parser": "^4.2.7",
    "tar": "^7.5.22",
    "tmp": "^0.2.7",
    "tsx": {
      "esbuild": "^0.28.2"
    },
    "undici": "^6.28.1",
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": false,
    "better-sqlite3-multiple-ciphers": false,
    "electron-winstaller": false,
    "electron@41.10.7": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "puppeteer@25.11.0": true
  }
}
