{
  "name": "react-example",
  "private": true,
  "version": "0.1.0-alpha",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "rebuild:node": "npm rebuild better-sqlite3-multiple-ciphers",
    "rebuild:electron": "npx @electron/rebuild -f -w better-sqlite3-multiple-ciphers",
    "dev": "npm run rebuild:node && concurrently --raw --kill-others \"npm run dev:server\" \"npm run dev:electron:wait\"",
    "dev:server": "tsx watch --ignore \"**/*.sqlite\" --ignore \"**/*.sqlite-*\" --ignore \"**/*.db\" --ignore \"**/*.db-*\" --ignore \"uploads/**\" server.ts",
    "dev:electron": "electron .",
    "dev:electron:wait": "wait-on tcp:127.0.0.1:3000 && npm run dev:electron",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.js",
    "preview": "vite preview",
    "clean": "npx rimraf dist dist-server release",
    "postinstall": "patch-package",
    "lint": "tsc --noEmit",
    "pack:win": "npm run clean && npm run build && npm run build:server && npm run rebuild:electron && electron-builder --win --x64",
    "pack:win:portable": "npm run clean && npm run build && npm run build:server && npx rimraf node_modules/better-sqlite3-multiple-ciphers/build && npm run rebuild:electron && electron-builder --win --x64 -c.win.target=portable"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@headlessui/react": "^2.2.10",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "@react-email/components": "^1.0.12",
    "@tailwindcss/vite": "^4.1.14",
    "@tippyjs/react": "^4.2.6",
    "@tiptap/core": "^3.23.6",
    "@tiptap/extension-highlight": "^3.23.6",
    "@tiptap/extension-horizontal-rule": "^3.23.6",
    "@tiptap/extension-image": "^3.23.6",
    "@tiptap/extension-list": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/extension-subscript": "^3.23.6",
    "@tiptap/extension-superscript": "^3.23.6",
    "@tiptap/extension-table": "^3.23.5",
    "@tiptap/extension-text-align": "^3.23.6",
    "@tiptap/extension-typography": "^3.23.6",
    "@tiptap/extensions": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@vitejs/plugin-react": "^5.0.4",
    "@xmldom/xmldom": "^0.9.10",
    "better-sqlite3-multiple-ciphers": "^12.9.0",
    "docxtemplater": "^3.68.6",
    "express": "^4.21.2",
    "handlebars": "^4.7.9",
    "jszip": "^3.10.1",
    "lodash.throttle": "^4.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "pizzip": "^3.2.0",
    "puppeteer": "^24.42.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hotkeys-hook": "^5.3.2",
    "react-is": "^19.2.6",
    "recharts": "^3.8.1",
    "sass": "^1.77.8",
    "tippy.js": "^6.3.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@base-ui/react": "^1.5.0",
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/lodash.throttle": "^4.1.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pizzip": "^3.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/xmldom": "^0.1.34",
    "class-variance-authority": "^0.7.1",
    "concurrently": "^9.2.1",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "patch-package": "^8.0.1",
    "react-email": "^6.3.2",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.2",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.maversoftlab.sge-ffe",
    "productName": "Gestor FFE",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "templates/**/*",
      "main.js",
      "splash.html",
      "package.json"
    ],
    "win": {
      "icon": "assets/favicon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "assets/icons",
      "target": "AppImage"
    },
    "mac": {
      "target": "zip"
    },
    "extraResources": [
      {
        "from": "binarios/${os}",
        "to": "binarios/${os}",
        "filter": [
          "**/*"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "info_instalador.txt",
      "createDesktopShortcut": true
    },
    "portable": {
      "splashImage": "assets/splash-unzip.bmp"
    }
  }
}
