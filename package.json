{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "npx @electron/rebuild -f -w better-sqlite3",
    "dev:server": "tsx watch --ignore \"**/*.sqlite\" --ignore \"**/*.sqlite-*\" --ignore \"**/*.db\" --ignore \"**/*.db-*\" --ignore \"uploads/**\" server.ts",
    "dev:electron": "electron .",
    "dev:electron:wait": "wait-on tcp:127.0.0.1:3000 && npm run dev:electron",
    "dev": "concurrently --raw --kill-others \"npm run dev:server\" \"npm run dev:electron:wait\"",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.js",
    "preview": "vite preview",
    "clean": "rimraf dist dist-server release",
    "lint": "tsc --noEmit",
    "pack:win": "npm run clean && npm run build && npm run build:server && npm run rebuild:electron && electron-builder --win --x64"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@headlessui/react": "^2.2.10",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docxtemplater": "^3.68.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "handlebars": "^4.7.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "pizzip": "^3.2.0",
    "puppeteer": "^24.42.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/pizzip": "^3.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-node": "^6.0.0",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.maversoftlab.sge-ffe",
    "productName": "Gestor FFE",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "templates/**/*",
      "main.js",
      "splash.html",
      "package.json"
    ],
    "win": {
      "icon": "assets/favicon.ico",
      "target": "nsis"
    },
    "linux": {
      "icon": "assets/icons",
      "target": "AppImage"
    },
    "extraResources": [
      {
        "from": "binarios/${os}",
        "to": "binarios/${os}",
        "filter": [
          "**/*"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "info_instalador.txt",
      "createDesktopShortcut": true
    }
  }
}
